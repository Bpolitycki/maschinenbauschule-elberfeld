<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
    datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"
    ns="http://www.dh.uni-wuppertal/ns/schueler/pages">
    <start>
        <element name="pages">
            <zeroOrMore>
                <ref name="page"/>
            </zeroOrMore>
        </element>
    </start>
    <define name="page">
        <element name="page">
            <attribute name="key">
                <text/>
            </attribute>
            <optional>
                <attribute name="name">
                    <text/>
                </attribute>
            </optional>
            <choice>
                <choice>
                    <attribute name="menu-only">
                        <value>true</value>
                    </attribute>
                    <attribute name="data-src">
                        <list>
                            <data type="string"/>
                        </list>
                    </attribute>
                </choice>
                <zeroOrMore>
                    <ref name="page"/>
                </zeroOrMore>
            </choice>
        </element>
    </define>
</grammar>
